    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "4.1.7",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "lefthook": "^2.1.6",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
