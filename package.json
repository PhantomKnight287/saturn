    "lucide-react": "^1.14.0",
    "nanoid": "^5.1.11",
    "next": "16.2.6",
    "next-safe-action": "^8.5.2",
    "next-themes": "^0.4.6",
    "nextjs-better-unstable-cache": "^1.1.3",
    "nodemailer": "^8.0.7",
    "radix-ui": "^1.4.3",
    "react": "19.2.6",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.6",
