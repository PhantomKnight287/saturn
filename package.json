{
  "name": "better-auth-nextjs-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typegen": "next typegen",
    "analyze": "cross-env ANALYZE=true next build",
    "start": "next start",
    "check": "ultracite check",
    "check:unsafe": "ultracite fix --unsafe",
    "check:write": "ultracite fix",
    "typecheck": "tsc --noEmit --incremental false",
    "check:spelling": "cspell -c .cspell.json --no-progress --no-summary --no-must-find-files --unique",
    "auth:generate": "bunx @better-auth/cli generate --config src/server/auth/index.ts --output src/server/db/schema/auth.ts --yes && bun check:unsafe src/server/db/schema/auth.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "email:dev": "email dev --dir ./src/emails/templates",
    "migrate": "drizzle-kit migrate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node node_modules/playwright/cli.js test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:docker": "docker compose -f docker-compose.test.yml run --rm --build unit",
    "test:docker:e2e": "docker compose -f docker-compose.test.yml run --rm --build e2e",
    "test:docker:down": "docker compose -f docker-compose.test.yml down -v"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@better-auth/api-key": "^1.6.9",
    "@better-auth/passkey": "^1.6.9",
    "@bprogress/next": "^3.2.12",
    "@content-collections/core": "^0.15.0",
    "@content-collections/markdown": "^0.1.4",
    "@content-collections/next": "^0.2.11",
    "@cspell/dict-bash": "^4.2.2",
    "@cspell/dict-npm": "^5.2.38",
    "@databuddy/sdk": "^2.4.11",
    "@hono/zod-openapi": "^1.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@neondatabase/serverless": "^1.1.0",
    "@next/bundle-analyzer": "16.2.6",
    "@paralleldrive/cuid2": "^3.3.0",
    "@polar-sh/better-auth": "^1.8.4",
    "@polar-sh/sdk": "^0.47.1",
    "@react-email/components": "^1.0.12",
    "@react-pdf/renderer": "^4.5.1",
    "@scalar/hono-api-reference": "^0.10.14",
    "@t3-oss/env-core": "^0.13.11",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-virtual": "^3.13.24",
    "@tiptap/core": "^3.22.5",
    "@tiptap/extension-image": "^3.22.5",
    "@tiptap/extension-link": "^3.22.5",
    "@tiptap/extension-placeholder": "^3.22.5",
    "@tiptap/extension-typography": "^3.22.5",
    "@tiptap/extension-underline": "^3.22.5",
    "@tiptap/pm": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "better-auth": "^1.6.9",
    "better-auth-ui": "npm:@daveyplate/better-auth-ui@latest",
